    "import re\n",
    "def check_string(s):\n",
    "    pattern = \"^[A-Za-z0-9]+$\" \n",
    "    return bool(re.match(pattern,s))\n",
    "s1 = \"Study15\"\n",
    "s2 = \"Study_15\" \n",
    "print(check_string(s1))\n",
    "print(check_string(s2))"
